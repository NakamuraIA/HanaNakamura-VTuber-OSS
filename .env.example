# ============================================================
#  Hana — modelo de configuracao
#
#  Copie este arquivo para `.env` e preencha o que for usar:
#      copy .env.example .env
#
#  Chave vazia = aquele recurso fica desligado. Nao quebra nada.
#  O `.env` esta no .gitignore. Nunca commite o seu.
# ============================================================

# ---------- IDENTIDADE ----------
# Como ela se chama e como te chama. O resto da personalidade fica na tela
# Memoria -> Fixas, nao no codigo — assim o projeto pode ser publico.
HANA_ASSISTANT_NAME=Hana
HANA_USER_NAME=Operador

# ---------- PROVIDERS DE LLM ----------
# O cerebro. Basta UM pra ela funcionar; os outros dao opcao de troca na tela.
# DeepSeek — barato e rapido, bom padrao pra comecar.
DEEPSEEK_API_KEY=
# Google AI Studio — o unico com busca nativa e visao boa.
GEMINI_API_KEY=
# Groq — o mais rapido. Tambem faz a transcricao de voz (STT).
GROQ_API_KEY=
# OpenRouter — porta pra centenas de modelos com uma chave so.
OPENROUTER_API_KEY=
QWEN_API_KEY=
# Endpoint OpenAI-compativel do workspace em Singapura (sem /chat/completions).
QWEN_SINGAPORE_API_KEY=
QWEN_SINGAPORE_BASE_URL=
# Maritaca (Sabia) — modelo brasileiro.
MARITACA_API_KEY=

# ---------- IDENTIFICACAO NO OPENROUTER ----------
# Aparecem no ranking publico deles. Nao sao segredo.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Hana Agent OSS

# ---------- VOZ ----------
# TTS = ela falar. STT = ela ouvir (usa a GROQ_API_KEY la de cima).
# O TTS "edge" e gratis e nao precisa de chave nenhuma.
ELEVENLABS_API_KEY=
FISH_API_KEY=

# ---------- FERRAMENTAS ----------
# Pesquisa web. Sem isto ela chuta fato atual em vez de pesquisar.
TAVILY_API_KEY=

# ---------- DISCORD ----------
# Token do bot.
DISCORD_TOKEN=
# SEU id de usuario do Discord: quem pode falar com ela.
# VAZIO = ninguem, e o bot nao responde a ninguem. E de proposito — sem isto,
# qualquer pessoa do servidor mandaria a IA rodar comando no seu PC.
# Varios donos: separe por virgula.
HANA_OWNER_ID=
# Webhook pro data/scripts/webhook_sender.py. E credencial: quem tem a URL
# posta no seu canal.
DISCORD_WEBHOOK_URL=

# ---------- MEMORIA ----------
# Busca semantica: alem de palavra exata, acha por SIGNIFICADO.
# 1 liga, 0 desliga.
HANA_MEMORY_SEMANTIC=0
# openrouter (nuvem, usa a chave acima) ou fastembed (local, sem custo).
HANA_MEMORY_EMBED_BACKEND=fastembed

# ---------- APP ----------
# Onde o front procura o back.
HANA_BACKEND_URL=http://127.0.0.1:8042
# Host do backend. MANTENHA 127.0.0.1.
#
# A API NAO tem autenticacao e expoe ferramentas que rodam comando no seu PC.
# Trocar pra 0.0.0.0 (pra acessar do celular, por exemplo) entrega shell sem
# senha a qualquer aparelho da rede. So faca isso atras de um proxy com login.
HANA_BACKEND_HOST=127.0.0.1
HANA_BACKEND_PORT=8042
